{
  "datasets": [
    {
      "name": "credit_risk_purpose",
      "displayName": "Credit Risk by Loan Purpose",
      "config": {
        "source": "workspace.default.credit_risk_gold_purpose",
        "measures": [
          {
            "name": "total_loans",
            "expr": "SUM(total_loans)",
            "displayName": "Total Loans"
          },
          {
            "name": "default_loans",
            "expr": "SUM(default_loans)",
            "displayName": "Default Loans"
          },
          {
            "name": "default_rate",
            "expr": "SUM(default_loans) / SUM(total_loans)",
            "displayName": "Default Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_loan_amount",
            "expr": "SUM(total_loan_amount)",
            "displayName": "Total Loan Amount",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          },
          {
            "name": "default_exposure",
            "expr": "SUM(default_exposure)",
            "displayName": "Default Exposure",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          }
        ],
        "version": "1.1",
        "comment": "Loan default metrics by loan purpose",
        "dimensions": [
          {
            "name": "loan_purpose",
            "expr": "loan_purpose",
            "displayName": "Loan Purpose"
          }
        ]
      }
    },
